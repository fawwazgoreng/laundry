NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/laundry
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=30
# Midtrans (required — the server refuses to boot without these)
MIDTRANS_MERCHANT_ID=G898000000000
MIDTRANS_SERVER_KEY=Mid-server-yourserverkey
MIDTRANS_CLIENT_KEY=Mid-client-yourclientkey