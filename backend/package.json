{
  "name": "backend",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "prod": "bun run src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src/domain/entities src/useCase",
    "test:unit": "bun test src/domain/entities src/useCase",
    "test:integration": "DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/laundry_test\" bun test --timeout=30000 tests/integration",
    "seed": "bun run src/infrastructure/seed/seed.ts",
    "prisma:generate": "prisma contract emit"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "@types/midtrans-client": "^1.4.0",
    "hono": "^4.13.0",
    "hono-rate-limiter": "^0.5.3",
    "midtrans-client": "^1.4.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.4",
    "prisma": "8.0.0-rc.23",
    "prisma-json-types-generator": "^5.1.1"
  },
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
