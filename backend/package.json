{
  "name": "backend",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "prod": "bun run src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test src/domain/entities src/useCase",
    "test:unit": "bun test src/domain/entities src/",
    "test:integration": "DATABASE_URL=\"mysql://laundry:laundry@127.0.0.1:3306/laundry_test\" bun test --timeout=30000 tests/integration",
    "seed": "bun run src/infrastructure/seed/seed.ts",
    "prisma:generate": "prisma contract emit"
  },
  "dependencies": {
    "@prisma/orm-mysql": "8.0.0-rc.24",
    "@types/midtrans-client": "^1.4.0",
    "decimal.js": "^10.6.0",
    "hono": "^4.13.0",
    "hono-rate-limiter": "^0.5.3",
    "midtrans-client": "^1.4.3",
    "mysql2": "^3.24.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "8.0.0-rc.24",
    "prisma-json-types-generator": "^5.1.1"
  },
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@prisma/orm-toolchain": "8.0.0-rc.24",
    "@prisma/orm-framework": "8.0.0-rc.24"
  }
}
